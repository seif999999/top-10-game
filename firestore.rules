rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profiles - users can only access their own data
    match /userProfiles/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // Allow reading public profile data for other users (for leaderboards, etc.)
      allow read: if request.auth != null && resource.data.isPublic == true;
      
      // ✅ SECURITY: Write with field validation to prevent data corruption and field injection
      allow write: if request.auth != null && 
                      request.auth.uid == userId &&
                      // Validate coins is number and non-negative (if present)
                      (!request.resource.data.keys().hasAny(['coins']) ||
                       (request.resource.data.coins is int &&
                        request.resource.data.coins >= 0 &&
                        request.resource.data.coins <= 999999)) &&
                      // Validate currentStreak is number (if present)
                      (!request.resource.data.keys().hasAny(['currentStreak']) ||
                       (request.resource.data.currentStreak is int &&
                        request.resource.data.currentStreak >= 0)) &&
                      // Validate currentWeek is number (if present)
                      (!request.resource.data.keys().hasAny(['currentWeek']) ||
                       (request.resource.data.currentWeek is int &&
                        request.resource.data.currentWeek >= 1)) &&
                      // Prevent field injection - only allow known fields
                      request.resource.data.keys().hasOnly([
                        'email', 'displayName', 'createdAt', 'stats', 
                        'selectedAvatar', 'avatarUrl', 'coins', 'lastUpdated', 'isPublic',
                        'lastLoginDate', 'currentStreak', 'currentWeek',
                        'unlockedCustomSlots',
                        'premiumType', 'premiumExpiresAt', 'premiumPurchasedAt',
                        'adFree', 'dailyRewardMultiplier', 'hasVIPBadge'
                      ]);
    }
    
    // User mission progress (subcollection under userProfiles)
    // Explicit rule for the single document used by missionService
    match /userProfiles/{userId}/missions/progress {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Coin transaction history (subcollection under userProfiles)
    match /userProfiles/{userId}/coinTransactions/{txId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Multiplayer games - authenticated users only with proper validation
    match /multiplayerGames/{roomCode} {
      // Allow read if:
      // 1. Room doesn't exist (for checking availability), OR
      // 2. User is already a participant in the room, OR
      // 3. Room is in 'lobby' status (open for joining)
      allow read: if request.auth != null && 
                     (resource == null ||
                      request.auth.uid in resource.data.players || 
                      resource.data.hostId == request.auth.uid ||
                      resource.data.status == 'lobby');
      allow create: if request.auth != null && validateRoomCreation();
      allow update: if request.auth != null && validateRoomUpdate();
      allow delete: if request.auth != null && resource.data.hostId == request.auth.uid;
    }
    
    // Action logs - rate limit service writes audit logs (userId must match auth)
    match /actionLogs/{logId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if false;
    }
    
    // Rate limits - allow writes for authentication rate limiting (before user is authenticated)
    // and for authenticated users to track their own rate limits only
    match /rateLimits/{documentId} {
      // Allow read for authenticated users or for password reset / auth rate limit checks (unauthenticated)
      allow read: if request.auth != null || 
                     documentId.matches('.*_password_reset') ||
                     documentId.matches('auth_.*');
      // Unauthenticated: auth_* (login rate limit) and *_password_reset (password reset by email)
      // Authenticated: only allow writing docs where userId in document matches request.auth.uid
      allow write: if documentId.matches('auth_.*') || 
                      documentId.matches('.*_password_reset') || 
                      (request.auth != null && request.resource.data.userId == request.auth.uid);
    }
    
    // Security events - write-only for logging, no read access (admin-only via backend)
    match /securityEvents/{eventId} {
      allow write: if request.auth != null; // Authenticated users can log security events
      allow read: if false; // No client-side reads (admin-only via backend)
    }
    
    // Security alerts - write-only for alerting, no read access (admin-only via backend)
    match /securityAlerts/{alertId} {
      allow write: if request.auth != null; // Authenticated users can create alerts
      allow read: if false; // No client-side reads (admin-only via backend)
    }
    
    // Privacy policy acceptances - users can only access their own acceptance records
    match /privacyPolicyAcceptances/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Time sync docs - temporary documents for time synchronization, allow authenticated writes
    match /timeSyncDocs/{docId} {
      allow read, write: if request.auth != null; // Authenticated users can sync time
    }
    
    // Custom questions - users can only access their own custom questions
    // Note: Currently stored in AsyncStorage, but if moved to Firestore, add rules here
    // match /customQuestions/{userId} {
    //   allow read, write: if request.auth != null && request.auth.uid == userId;
    // }
    
    // Test collection - only allow in development (remove in production)
    match /test/{document=**} {
      allow read, write: if false; // Disabled for security
    }
    
    // Validation functions
    function validateRoomCreation() {
      return request.resource.data.hostId == request.auth.uid &&
             request.resource.data.players[request.auth.uid].isHost == true &&
             request.resource.data.status == 'lobby';
    }
    
    function validateRoomUpdate() {
      // Allow updates if user is already a participant (can update game state, leave, etc.)
      let isParticipant = request.auth.uid in resource.data.players ||
                          resource.data.hostId == request.auth.uid;
      
      // Allow joining only: room in lobby, hostId unchanged, and only adding self to players
      // (prevents a client from overwriting hostId/players or adding fake participants)
      let oldPlayers = resource.data.players.keys();
      let newPlayers = request.resource.data.players.keys();
      let onlyAddingSelf = resource.data.status == 'lobby' &&
                           request.resource.data.status == 'lobby' &&
                           request.resource.data.hostId == resource.data.hostId &&
                           request.auth.uid in request.resource.data.players &&
                           newPlayers.hasAll(oldPlayers) &&
                           newPlayers.size() == oldPlayers.size() + 1;
      let isJoining = onlyAddingSelf;
      
      return isParticipant || isJoining;
    }
    
    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}