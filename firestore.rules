rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profiles - users can only access their own data
    match /userProfiles/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // Allow reading public profile data for other users (for leaderboards, etc.)
      allow read: if request.auth != null && resource.data.isPublic == true;
      
      // ✅ SECURITY: Write with field validation to prevent data corruption and field injection
      allow write: if request.auth != null && 
                      request.auth.uid == userId &&
                      // Validate email is string and reasonable length
                      request.resource.data.email is string &&
                      request.resource.data.email.size() <= 254 &&
                      // Validate displayName is string and reasonable length (if present)
                      (!request.resource.data.keys().hasAny(['displayName']) ||
                       (request.resource.data.displayName is string &&
                        request.resource.data.displayName.size() <= 30)) &&
                      // Validate coins is number and non-negative (if present)
                      (!request.resource.data.keys().hasAny(['coins']) ||
                       (request.resource.data.coins is int &&
                        request.resource.data.coins >= 0 &&
                        request.resource.data.coins <= 999999)) &&
                      // Prevent field injection - only allow known fields
                      request.resource.data.keys().hasOnly([
                        'email', 'displayName', 'createdAt', 'stats', 
                        'selectedAvatar', 'avatarUrl', 'coins', 'lastUpdated', 'isPublic'
                      ]);
    }
    
    // Multiplayer games - authenticated users only with proper validation
    match /multiplayerGames/{roomCode} {
      // Only allow read if user is a participant in the room
      allow read: if request.auth != null && 
                     (request.auth.uid in resource.data.players || 
                      resource.data.hostId == request.auth.uid);
      allow create: if request.auth != null && validateRoomCreation();
      allow update: if request.auth != null && validateRoomUpdate();
      allow delete: if request.auth != null && resource.data.hostId == request.auth.uid;
    }
    
    // Rate limits - allow writes for authentication rate limiting (before user is authenticated)
    // and for authenticated users to track their own rate limits
    match /rateLimits/{documentId} {
      // Allow read for authenticated users (for their own entries)
      allow read: if request.auth != null;
      // Allow write for auth rate limits (unauthenticated) or for authenticated users
      // Auth rate limits use "auth_" prefix and are for login attempts
      allow write: if documentId.matches('auth_.*') || request.auth != null;
    }
    
    // Security events - write-only for logging, no read access (admin-only via backend)
    match /securityEvents/{eventId} {
      allow write: if request.auth != null; // Authenticated users can log security events
      allow read: if false; // No client-side reads (admin-only via backend)
    }
    
    // Security alerts - write-only for alerting, no read access (admin-only via backend)
    match /securityAlerts/{alertId} {
      allow write: if request.auth != null; // Authenticated users can create alerts
      allow read: if false; // No client-side reads (admin-only via backend)
    }
    
    // Privacy policy acceptances - users can only access their own acceptance records
    match /privacyPolicyAcceptances/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Time sync docs - temporary documents for time synchronization, allow authenticated writes
    match /timeSyncDocs/{docId} {
      allow read, write: if request.auth != null; // Authenticated users can sync time
    }
    
    // Custom questions - users can only access their own custom questions
    // Note: Currently stored in AsyncStorage, but if moved to Firestore, add rules here
    // match /customQuestions/{userId} {
    //   allow read, write: if request.auth != null && request.auth.uid == userId;
    // }
    
    // Test collection - only allow in development (remove in production)
    match /test/{document=**} {
      allow read, write: if false; // Disabled for security
    }
    
    // Validation functions
    function validateRoomCreation() {
      return request.resource.data.hostId == request.auth.uid &&
             request.resource.data.players[request.auth.uid].isHost == true &&
             request.resource.data.status == 'lobby';
    }
    
    function validateRoomUpdate() {
      // ✅ SECURITY: Only allow updates if user is participant
      let isParticipant = request.auth.uid in resource.data.players ||
                          resource.data.hostId == request.auth.uid;
      
      if (!isParticipant) {
        return false;
      }
      
      // ✅ SECURITY: Field type validation for room updates
      // Validate roomCode is string and matches document ID
      if (request.resource.data.keys().hasAny(['roomCode'])) {
        return request.resource.data.roomCode is string &&
               request.resource.data.roomCode == roomCode &&
               request.resource.data.roomCode.size() == 6;
      }
      
      // Validate hostId is string if present
      if (request.resource.data.keys().hasAny(['hostId'])) {
        return request.resource.data.hostId is string &&
               request.resource.data.hostId.size() > 0;
      }
      
      // Validate status is valid enum value
      if (request.resource.data.keys().hasAny(['status'])) {
        return request.resource.data.status is string &&
               request.resource.data.status in ['lobby', 'playing', 'finished', 'closed'];
      }
      
      // Validate gamePhase is valid enum value
      if (request.resource.data.keys().hasAny(['gamePhase'])) {
        return request.resource.data.gamePhase is string &&
               request.resource.data.gamePhase in ['lobby', 'question', 'answers', 'results', 'finished'];
      }
      
      // ✅ SECURITY: Prevent privilege escalation - only host can modify hostId or isHost
      let isHost = resource.data.hostId == request.auth.uid;
      
      // Prevent unauthorized hostId changes
      if (request.resource.data.diff(resource.data).affectedKeys().hasAny(['hostId'])) {
        return isHost && request.resource.data.hostId == request.auth.uid;
      }
      
      // Prevent unauthorized isHost changes in players map
      // Note: Firestore rules don't support deep diff on maps easily,
      // but we can check if isHost field is being modified
      // This is a basic check - more comprehensive validation would require checking each player
      
      return true;
    }
    
    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}