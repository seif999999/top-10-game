rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /userProfiles/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null && resource.data.isPublic == true;

      function userProfileEconomyKeys() {
        return [
          'coins', 'premiumType', 'premiumExpiresAt', 'premiumPurchasedAt',
          'adFree', 'dailyRewardMultiplier', 'hasVIPBadge'
        ];
      }

      function userProfileAllowedKeysOnCreate() {
        return [
          'email', 'displayName', 'createdAt', 'stats', 'selectedAvatar', 'avatarUrl',
          'lastUpdated', 'isPublic', 'lastLoginDate', 'currentStreak', 'currentWeek',
          'unlockedCustomSlots', 'soundEnabled', 'musicEnabled', 'language'
        ];
      }

      function userProfileMutableKeysOnUpdate() {
        return [
          'email', 'displayName', 'stats', 'selectedAvatar', 'avatarUrl',
          'lastUpdated', 'isPublic', 'lastLoginDate', 'currentStreak', 'currentWeek',
          'unlockedCustomSlots', 'soundEnabled', 'musicEnabled', 'language',
          'coins', 'premiumType', 'premiumExpiresAt', 'premiumPurchasedAt',
          'adFree', 'dailyRewardMultiplier', 'hasVIPBadge'
        ];
      }

      function prevCoins() {
        return resource.data.keys().hasAll(['coins']) ? resource.data.coins : 0;
      }

      function userProfileEconomyGuards() {
        let changed = request.resource.data.diff(resource.data).changedKeys();
        return !changed.hasAny(userProfileEconomyKeys()) || (
          (!changed.hasAny(['coins']) || (
            (request.resource.data.coins is int || request.resource.data.coins is float) &&
            request.resource.data.coins >= 0 &&
            request.resource.data.coins <= prevCoins() + 1000000 &&
            request.resource.data.coins >= prevCoins() - 1000000
          )) &&
          (!changed.hasAny(['premiumType']) || (
            request.resource.data.premiumType == null ||
            request.resource.data.premiumType in ['monthly', 'quarterly', 'yearly']
          )) &&
          (!changed.hasAny(['dailyRewardMultiplier']) || (
            request.resource.data.dailyRewardMultiplier == null ||
            request.resource.data.dailyRewardMultiplier == 1 ||
            request.resource.data.dailyRewardMultiplier == 2
          )) &&
          (!changed.hasAny(['adFree']) || request.resource.data.adFree is bool) &&
          (!changed.hasAny(['hasVIPBadge']) || request.resource.data.hasVIPBadge is bool)
        );
      }

      function userProfileCreateValid() {
        return request.auth != null &&
               request.auth.uid == userId &&
               (
                 (
                   !request.resource.data.keys().hasAny(userProfileEconomyKeys()) &&
                   request.resource.data.keys().hasOnly(userProfileAllowedKeysOnCreate())
                 ) ||
                 (
                   request.resource.data.keys().hasOnly(['coins', 'lastUpdated']) &&
                   request.resource.data.coins >= 0 &&
                   request.resource.data.coins <= 1000000
                 )
               );
      }

      function userProfileUpdateValid() {
        let changed = request.resource.data.diff(resource.data).changedKeys();
        return request.auth != null &&
               request.auth.uid == userId &&
               changed.hasOnly(userProfileMutableKeysOnUpdate()) &&
               userProfileEconomyGuards();
      }

      allow create: if userProfileCreateValid();
      allow update: if userProfileUpdateValid();
      allow delete: if false;
    }

    match /userProfiles/{userId}/missions/progress {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /userProfiles/{userId}/coinTransactions/{txId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.keys().hasOnly(['amount', 'type', 'reason', 'timestamp']) &&
        request.resource.data.type in ['earned', 'spent'] &&
        (request.resource.data.amount is int || request.resource.data.amount is float) &&
        request.resource.data.amount >= -500000 &&
        request.resource.data.amount <= 500000;
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /multiplayerGames/{roomCode} {
      allow read: if request.auth != null &&
                     (resource == null ||
                      request.auth.uid in resource.data.players ||
                      resource.data.hostId == request.auth.uid ||
                      resource.data.status == 'lobby');
      allow create: if request.auth != null && validateRoomCreation();
      allow update: if request.auth != null && validateRoomUpdate();
      allow delete: if request.auth != null && resource.data.hostId == request.auth.uid;
    }

    match /actionLogs/{logId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if false;
    }

    match /rateLimits/{documentId} {
      function rateLimitAuthFieldsValid() {
        return request.resource.data.keys().hasAll(['identifier', 'count', 'lastAttempt', 'type']) &&
          request.resource.data.keys().hasOnly(['identifier', 'count', 'lastAttempt', 'type', 'blockedUntil']) &&
          request.resource.data.type == 'authentication' &&
          request.resource.data.identifier is string &&
          request.resource.data.count is int &&
          request.resource.data.count >= 0 &&
          request.resource.data.count <= 10000;
      }

      function rateLimitPasswordResetFieldsValid() {
        return request.resource.data.keys().hasAll(['userId', 'actionType', 'attempts', 'firstAttempt', 'lastAttempt']) &&
          request.resource.data.keys().hasOnly(
            ['userId', 'actionType', 'attempts', 'firstAttempt', 'lastAttempt', 'blockedUntil', 'metadata']) &&
          request.resource.data.actionType == 'passwordReset' &&
          request.resource.data.userId is string &&
          documentId == request.resource.data.userId + '_passwordReset' &&
          request.resource.data.attempts is int &&
          request.resource.data.attempts >= 0 &&
          request.resource.data.attempts <= 100000;
      }

      function rateLimitAuthenticatedActionWrite() {
        return request.auth != null &&
          request.resource.data.userId == request.auth.uid &&
          documentId == request.resource.data.userId + '_' + request.resource.data.actionType &&
          request.resource.data.actionType is string;
      }

      allow read: if request.auth != null ||
                     documentId.matches('.*_passwordReset') ||
                     documentId.matches('auth_.*');
      allow create, update: if
        (request.auth == null && documentId.matches('auth_.*') && rateLimitAuthFieldsValid()) ||
        (request.auth == null && documentId.matches('.*_passwordReset') && rateLimitPasswordResetFieldsValid()) ||
        (request.auth != null &&
          !documentId.matches('auth_.*') &&
          !documentId.matches('.*_passwordReset') &&
          rateLimitAuthenticatedActionWrite());
      allow delete: if
        (documentId.matches('auth_.*') && request.auth != null && resource.data.type == 'authentication') ||
        (request.auth != null &&
          !documentId.matches('auth_.*') &&
          !documentId.matches('.*_passwordReset') &&
          resource.data.userId == request.auth.uid);
    }

    function securityEventCreateValid() {
      return request.resource.data.keys().hasAll(['userId', 'eventType', 'severity', 'description', 'metadata', 'resolved', 'timestamp']) &&
        request.resource.data.resolved == false &&
        request.resource.data.severity in ['LOW', 'MEDIUM', 'HIGH', 'CRITICAL'] &&
        (
          (request.auth != null &&
            request.resource.data.userId == request.auth.uid &&
            request.resource.data.eventType is string) ||
          (request.auth == null &&
            request.resource.data.eventType == 'AUTHENTICATION_FAILURE' &&
            request.resource.data.userId is string &&
            request.resource.data.severity == 'MEDIUM')
        );
    }

    match /securityEvents/{eventId} {
      allow create: if securityEventCreateValid();
      allow read, update, delete: if false;
    }

    match /securityAlerts/{alertId} {
      allow create: if request.auth != null &&
        request.resource.data.keys().hasOnly(['eventId', 'alertType', 'message', 'severity', 'createdAt', 'acknowledged']) &&
        request.resource.data.alertType is string &&
        request.resource.data.message is string &&
        request.resource.data.severity in ['LOW', 'MEDIUM', 'HIGH', 'CRITICAL'] &&
        request.resource.data.acknowledged == false;
      allow read, update, delete: if false;
    }

    match /privacyPolicyAcceptances/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /timeSyncDocs/{docId} {
      allow read, create, update: if request.auth != null &&
        docId.matches('^' + request.auth.uid + '_.+') &&
        request.resource.data.keys().hasOnly(['timestamp', 'clientTime']);
      allow delete: if request.auth != null && docId.matches('^' + request.auth.uid + '_.+');
    }

    match /test/{document=**} {
      allow read, write: if false;
    }

    function validateRoomCreation() {
      return request.resource.data.hostId == request.auth.uid &&
             request.resource.data.players[request.auth.uid].isHost == true &&
             request.resource.data.status == 'lobby';
    }

    function validateRoomUpdate() {
      let isHost = request.auth.uid == resource.data.hostId;
      let isParticipant = request.auth.uid in resource.data.players;
      let affected = request.resource.data.diff(resource.data).changedKeys();

      let oldPlayers = resource.data.players.keys();
      let newPlayers = request.resource.data.players.keys();
      let onlyAddingSelf = resource.data.status == 'lobby' &&
                           request.resource.data.status == 'lobby' &&
                           request.resource.data.hostId == resource.data.hostId &&
                           request.auth.uid in request.resource.data.players &&
                           newPlayers.hasAll(oldPlayers) &&
                           newPlayers.size() == oldPlayers.size() + 1;
      let isJoining = onlyAddingSelf;

      let hostLockedKeys = [
        'hostId', 'questions', 'category', 'roomCode', 'createdAt', 'maxPlayers'
      ];

      return request.resource.data.hostId == resource.data.hostId &&
        (isHost || !affected.hasAny(hostLockedKeys)) &&
        !(resource.data.status == 'lobby' && request.resource.data.status == 'playing' && !isHost) &&
        (isParticipant || isJoining);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
