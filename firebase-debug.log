[debug] [2026-02-06T22:51:54.051Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/top10-game-f9219/rulesets {"name":"projects/top10-game-f9219/rulesets/e359c2c7-b663-49a6-9805-b1d06adfc0a9","source":{"files":[{"content":"rules_version = '2';\r\nservice cloud.firestore {\r\n  match /databases/{database}/documents {\r\n    // User profiles - users can only access their own data\r\n    match /userProfiles/{userId} {\r\n      allow read: if request.auth != null && request.auth.uid == userId;\r\n      // Allow reading public profile data for other users (for leaderboards, etc.)\r\n      allow read: if request.auth != null && resource.data.isPublic == true;\r\n      \r\n      // ✅ SECURITY: Write with field validation to prevent data corruption and field injection\r\n      allow write: if request.auth != null && \r\n                      request.auth.uid == userId &&\r\n                      // Validate coins is number and non-negative (if present)\r\n                      (!request.resource.data.keys().hasAny(['coins']) ||\r\n                       (request.resource.data.coins is int &&\r\n                        request.resource.data.coins >= 0 &&\r\n                        request.resource.data.coins <= 999999)) &&\r\n                      // Validate currentStreak is number (if present)\r\n                      (!request.resource.data.keys().hasAny(['currentStreak']) ||\r\n                       (request.resource.data.currentStreak is int &&\r\n                        request.resource.data.currentStreak >= 0)) &&\r\n                      // Validate currentWeek is number (if present)\r\n                      (!request.resource.data.keys().hasAny(['currentWeek']) ||\r\n                       (request.resource.data.currentWeek is int &&\r\n                        request.resource.data.currentWeek >= 1)) &&\r\n                      // Prevent field injection - only allow known fields\r\n                      request.resource.data.keys().hasOnly([\r\n                        'email', 'displayName', 'createdAt', 'stats', \r\n                        'selectedAvatar', 'avatarUrl', 'coins', 'lastUpdated', 'isPublic',\r\n                        'lastLoginDate', 'currentStreak', 'currentWeek'\r\n                      ]);\r\n    }\r\n    \r\n    // Multiplayer games - authenticated users only with proper validation\r\n    match /multiplayerGames/{roomCode} {\r\n      // Allow read if:\r\n      // 1. Room doesn't exist (for checking availability), OR\r\n      // 2. User is already a participant in the room, OR\r\n      // 3. Room is in 'lobby' status (open for joining)\r\n      allow read: if request.auth != null && \r\n                     (resource == null ||\r\n                      request.auth.uid in resource.data.players || \r\n                      resource.data.hostId == request.auth.uid ||\r\n                      resource.data.status == 'lobby');\r\n      allow create: if request.auth != null && validateRoomCreation();\r\n      allow update: if request.auth != null && validateRoomUpdate();\r\n      allow delete: if request.auth != null && resource.data.hostId == request.auth.uid;\r\n    }\r\n    \r\n    // Rate limits - allow writes for authentication rate limiting (before user is authenticated)\r\n    // and for authenticated users to track their own rate limits\r\n    match /rateLimits/{documentId} {\r\n      // Allow read for authenticated users or for password reset rate limit checks (unauthenticated)\r\n      allow read: if request.auth != null || \r\n                     documentId.matches('.*_passwordReset') ||\r\n                     documentId.matches('auth_.*');\r\n      // Allow write for auth rate limits and password reset rate limits (unauthenticated) \r\n      // or for authenticated users\r\n      // Auth rate limits use \"auth_\" prefix, password reset uses \"_passwordReset\" suffix\r\n      allow write: if documentId.matches('auth_.*') || \r\n                      documentId.matches('.*_passwordReset') || \r\n                      request.auth != null;\r\n    }\r\n    \r\n    // Security events - write-only for logging, no read access (admin-only via backend)\r\n    match /securityEvents/{eventId} {\r\n      allow write: if request.auth != null; // Authenticated users can log security events\r\n      allow read: if false; // No client-side reads (admin-only via backend)\r\n    }\r\n    \r\n    // Security alerts - write-only for alerting, no read access (admin-only via backend)\r\n    match /securityAlerts/{alertId} {\r\n      allow write: if request.auth != null; // Authenticated users can create alerts\r\n      allow read: if false; // No client-side reads (admin-only via backend)\r\n    }\r\n    \r\n    // Privacy policy acceptances - users can only access their own acceptance records\r\n    match /privacyPolicyAcceptances/{userId} {\r\n      allow read, write: if request.auth != null && request.auth.uid == userId;\r\n    }\r\n    \r\n    // Time sync docs - temporary documents for time synchronization, allow authenticated writes\r\n    match /timeSyncDocs/{docId} {\r\n      allow read, write: if request.auth != null; // Authenticated users can sync time\r\n    }\r\n    \r\n    // Custom questions - users can only access their own custom questions\r\n    // Note: Currently stored in AsyncStorage, but if moved to Firestore, add rules here\r\n    // match /customQuestions/{userId} {\r\n    //   allow read, write: if request.auth != null && request.auth.uid == userId;\r\n    // }\r\n    \r\n    // Test collection - only allow in development (remove in production)\r\n    match /test/{document=**} {\r\n      allow read, write: if false; // Disabled for security\r\n    }\r\n    \r\n    // Validation functions\r\n    function validateRoomCreation() {\r\n      return request.resource.data.hostId == request.auth.uid &&\r\n             request.resource.data.players[request.auth.uid].isHost == true &&\r\n             request.resource.data.status == 'lobby';\r\n    }\r\n    \r\n    function validateRoomUpdate() {\r\n      // ✅ SECURITY: Only allow updates if user is participant\r\n      let isParticipant = request.auth.uid in resource.data.players ||\r\n                          resource.data.hostId == request.auth.uid;\r\n      \r\n      // Basic validation: must be a participant\r\n      return isParticipant;\r\n    }\r\n    \r\n    // Deny all other access\r\n    match /{document=**} {\r\n      allow read, write: if false;\r\n    }\r\n  }\r\n}","name":"firestore.rules"}]},"createTime":"2026-02-06T22:51:53.920815Z","metadata":{"services":["cloud.firestore"]}}
