{
  "cli": { "version": ">= 12.0.0" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {}
    },
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": true },
      "env": {}
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {}
    },
    "production": {
      "distribution": "store",
      "android": { "buildType": "app-bundle" },
      "env": {}
    }
  }
}
